{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P2.1 graybox projectile baseline record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","room_id","x","y","enemy","speed","radius","bounces","penetrations","remaining_range","unbounded","direction_x","direction_y"],
  "properties": {
    "id": {"type":"string","minLength":1,"maxLength":64},
    "room_id": {"type":"integer","minimum":0,"maximum":7},
    "x": {"type":"number","minimum":0,"maximum":34},
    "y": {"type":"number","minimum":0,"maximum":20},
    "enemy": {"type":"boolean"},
    "speed": {"type":"number","exclusiveMinimum":0,"maximum":64},
    "radius": {"type":"number","exclusiveMinimum":0,"maximum":1},
    "bounces": {"type":"integer","minimum":0,"maximum":1},
    "penetrations": {"type":"integer","minimum":0,"maximum":2},
    "remaining_range": {"type":"null"},
    "unbounded": {"const":true},
    "direction_x": {"type":"number","minimum":-1,"maximum":1},
    "direction_y": {"type":"number","minimum":-1,"maximum":1}
  }
}
