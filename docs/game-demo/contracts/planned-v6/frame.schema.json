                      "protection",
                      "control_effect",
                      "rescue",
                      "mechanism",
                      "reach"
                    ]
                  },
                  "target_player_id": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "pattern": "^[1-9][0-9]{0,18}$",
