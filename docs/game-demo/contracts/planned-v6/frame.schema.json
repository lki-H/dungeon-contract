                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "deadline_game_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "selected_game_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "automatic": {
                    "type": "boolean"
                  }
                }
              }
            ]
          }
        }
      },
      "maxItems": 128,
      "minItems": 0
    },
    "terminal": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "reason",
            "cutoff_frame",
            "cutoff_sequence"
          ],
          "properties": {
            "result": {
              "type": "string",
              "enum": [
                "success",
                "failed",
                "aborted"
              ]
            },
            "reason": {
              "type": "string",
              "enum": [
                "boss_defeated",
                "no_recovery",
                "active_limit",
                "wall_limit",
                "technical_failure",
                "all_members_left",
                "service_lost",
                "authorization_revoked"
              ]
            },
            "cutoff_frame": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "cutoff_sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            }
          }
        }
      ]
    },
    "summary": {
      "anyOf": [
        {
          "type": "null"
