                    "maximum": 2147483647
                  },
                  "knockdowns": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "deaths": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "rescues": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "protected_damage": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "cleared_projectiles": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "eligible_damage_actions": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "growth": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9_:.\\-]+$"
                    },
                    "maxItems": 3,
                    "minItems": 0
                  },
                  "choices": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "node_id",
                        "option_id",
                        "candidate_revision",
                        "candidate_hash",
                        "opened_game_ms",
                        "deadline_game_ms",
                        "selected_game_ms",
                        "automatic"
                      ],
                      "properties": {
                        "node_id": {
                          "type": "string",
                          "enum": [
                            "growth_1",
                            "growth_2",
                            "growth_3"
