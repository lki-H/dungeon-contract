                      "maximum": 2147483647
                    },
                    "effective_amount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483647
                    },
                    "effective_time_ms": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483647
                    },
