{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protocol6 planned finite Go facts; high-frequency projectile and terrain lifecycle excluded",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "task_version",
    "run_id",
    "source_generation",
    "sequence",
    "world_frame_id",
    "control_watermark",
    "clock",
    "facts",
    "terminal",
    "summary",
    "fingerprint"
  ],
  "properties": {
    "schema_version": {
      "const": 6,
      "type": "number"
    },
    "operation": {
      "const": "dc_ruins.v6",
      "type": "string"
    },
    "task_version": {
      "const": "dc_tasks.v5.p4.1",
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_:.\\-]+$"
    },
    "source_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "world_frame_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "control_watermark": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
