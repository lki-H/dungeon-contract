                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64,
                          "pattern": "^[A-Za-z0-9_:.\\-]+$"
                        }
                      ]
                    }
                  }
                }
              }
            },
            "maxItems": 4,
            "minItems": 0
          },
          "growth_choice": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "node_id",
                  "option_id",
                  "candidate_revision",
                  "candidate_hash",
                  "opened_game_ms",
                  "deadline_game_ms",
