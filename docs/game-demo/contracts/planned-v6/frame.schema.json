                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        "opened_game_ms": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 2147483647
                        },
                        "deadline_game_ms": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 2147483647
                        },
                        "selected_game_ms": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 2147483647
                        },
                        "automatic": {
                          "type": "boolean"
                        }
                      }
                    },
                    "maxItems": 3,
                    "minItems": 0
                  }
                }
              },
              "maxItems": 4,
              "minItems": 1
            }
          }
        }
      ]
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
