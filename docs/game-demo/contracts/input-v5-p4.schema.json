{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dc:input:5:p4",
  "title": "Protocol 5 runtime flat continuous intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "run_id",
    "source_generation",
    "connection_generation",
    "input_sequence",
    "weapon_id",
    "weapon_revision",
    "move_x",
    "move_y",
    "aim_u16",
    "message",
    "action_watermark",
    "attack_held",
    "charge_held",
    "interact_held",
    "attack_episode_id",
    "charge_episode_id"
  ],
  "properties": {
    "protocol_version": {
      "const": 5
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "source_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "connection_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "input_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "weapon_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "weapon_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "move_x": {
      "type": "integer",
      "minimum": -1000,
      "maximum": 1000
    },
    "move_y": {
      "type": "integer",
      "minimum": -1000,
      "maximum": 1000
    },
    "aim_u16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "message": {
      "const": "dc.input.v5"
    },
    "action_watermark": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "attack_held": {
      "type": "boolean"
    },
    "charge_held": {
      "type": "boolean"
    },
    "interact_held": {
      "type": "boolean"
    },
    "attack_episode_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "charge_episode_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
