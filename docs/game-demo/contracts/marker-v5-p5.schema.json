{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "P5 cosmetic marker request. Positions are tiles in the current room. Authority additionally validates actual room bounds, identity, life, input window, pause, rate and capacity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "run_id", "source_generation", "connection_generation", "input_sequence", "marker_id", "room_id", "x", "y"],
  "properties": {
    "protocol_version": {"const": 5},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "source_generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "connection_generation": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "input_sequence": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "marker_id": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
    "room_id": {"type": "integer", "minimum": 0, "maximum": 15},
    "x": {"type": "number", "minimum": 1, "maximum": 33},
    "y": {"type": "number", "minimum": 1, "maximum": 19}
  }
}
