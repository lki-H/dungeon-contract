  "answers": [
    {
      "id": "QPR-01",
      "decision": "all_flying_projectiles_unbounded",
      "confirmed_answer": "全部实际飞行弹体取消距离上限",
      "confirmed": true
    },
    {
      "id": "QPR-02",
      "decision": "same_room_collisions_no_room_crossing",
      "confirmed_answer": "仍碰撞、始终留在原房，不跨开放门",
      "confirmed": true
    },
    {
      "id": "QPR-03",
      "decision": "no_fixed_flight_lifetime",
      "confirmed_answer": "正常飞行不设固定距离或寿命截断",
      "confirmed": true
    },
    {
      "id": "QPR-04",
      "decision": "turret_acquisition_12_tiles",
      "confirmed_answer": "普通及双炮塔索敌12格，炮弹飞行不限距离",
      "confirmed": true
    },
    {
      "id": "QPR-05",
      "decision": "enemy_engagement_limits_preserved",
      "confirmed_answer": "敌人保留接敌/发动距离，远处被击中正常警戒靠近",
      "confirmed": true
    },
    {
      "id": "QPR-06",
      "decision": "penetration_bounce_chain_unchanged",
      "confirmed_answer": "弩2目标/模块3，符弹一次反弹，连锁一目标/3格保持",
      "confirmed": true
    },
    {
      "id": "QPR-07",
      "decision": "other_combat_parameters_unchanged",
      "confirmed_answer": "其他伤害/弹速/攻速/弹匣/装填/CD保持，无距离衰减",
      "confirmed": true
    },
    {
      "id": "QPR-08",
      "decision": "offscreen_hit_generic_feedback",
      "confirmed_answer": "屏外合法命中提供简要确认，不泄露精确敌位/数字或增加探索",
      "confirmed": true
    },
    {
      "id": "QPR-09",
      "decision": "retain_player_projectiles_after_incapacitation",
      "confirmed_answer": "临时倒地/死亡保留已发弹；永久退出/终态清理",
      "confirmed": true
    },
    {
      "id": "QPR-10",
      "decision": "retain_projectiles_in_source_room_after_owner_transition",
      "confirmed_answer": "切房不清弹，留在原房继续运行",
      "confirmed": true
    },
    {
      "id": "QPR-11",
      "decision": "retain_between_waves_clear_on_room_completion",
      "confirmed_answer": "波次间保留，清敌及机关等房间条件齐备后清全房残弹",
      "confirmed": true
    },
    {
      "id": "QPR-12",
      "decision": "technical_wait_clears_projectiles",
      "confirmed_answer": "技术等待清理在途弹、不退款，恢复敌人完整重新起手",
      "confirmed": true
    },
    {
      "id": "QPR-13",
      "decision": "door_uses_shared_rune_bounce",
      "confirmed_answer": "符弹可在开门/锁门边界反弹，与墙柱箱共用总一次",
      "confirmed": true
    },
    {
      "id": "QPR-14",
      "decision": "turret_survives_owner_incapacitation",
      "confirmed_answer": "主人倒地/死亡炮塔也继续剩余寿命，切房留原房",
      "confirmed": true
    },
    {
      "id": "QPR-15",
      "decision": "self_progress_but_spatial_eligible_checks",
      "confirmed_answer": "合法延迟伤害/击杀与普通self继续，eligible仍按原区域/5秒证据，未倒地失败不恢复",
      "confirmed": true
    },
    {
      "id": "QPR-16",
      "decision": "reserve_committed_capacity_reject_new_actions",
      "confirmed_answer": "保留在途弹、预约已承诺攻击，新攻击超限明确拒绝且不扣资源",
      "confirmed": true
    },
    {
      "id": "QPR-17",
      "decision": "enemy_start_ranges_8_and_12",
      "confirmed_answer": "射手8格内起手/约5格站位，Boss扇弹12格内起手",
      "confirmed": true
    },
    {
      "id": "QPR-18",
      "decision": "wipe_does_not_wait_for_projectiles_or_turrets",
      "confirmed_answer": "全队无恢复手段即时失败，同帧必需目标完成优先，不等炮塔代打",
      "confirmed": true
    },
    {
      "id": "QPR-19",
      "decision": "turret_lifetime_advances_in_technical_wait",
      "confirmed_answer": "技术等待炮塔停射、game寿命继续，恢复不补射，过期/清房/退出/终态清理",
      "confirmed": true
    }
  ],
