{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dc:baseline-ack:5:p4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "run_id",
    "source_generation",
    "connection_generation",
    "state_revision"
  ],
  "properties": {
    "protocol_version": {
      "const": 5
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "source_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "connection_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "state_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    }
  }
}
