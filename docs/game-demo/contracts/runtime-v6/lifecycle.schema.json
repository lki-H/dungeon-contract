{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protocol6 P5 actual lifecycle codec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "run_id",
    "source_generation",
    "connection_generation",
    "interest_revision",
    "events"
  ],
  "properties": {
    "protocol_version": {
      "const": 6
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "source_generation": {
      "type": "integer",
      "minimum": 1
    },
    "connection_generation": {
      "type": "integer",
      "minimum": 1
    },
    "interest_revision": {
      "type": "integer",
      "minimum": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "kind",
          "entity_id",
          "room_id",
          "frame",
          "game_ms",
          "subtick",
          "trajectory_revision",
          "state",
          "reason",
          "delivery_sequence"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "spawn",
              "bounce",
              "terminate"
            ]
          },
          "entity_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "room_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 14
          },
          "frame": {
            "type": "integer",
            "minimum": 0
          },
          "game_ms": {
            "type": "integer",
            "minimum": 0
          },
          "subtick": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "trajectory_revision": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "room_id",
              "x",
              "y",
              "direction_x",
              "direction_y",
              "radius",
              "speed",
              "enemy",
              "rune_bolt",
              "wind_volley",
              "bounces",
              "penetrations",
              "root",
              "owner",
              "source_life",
              "damage",
              "frost",
              "chain",
              "trajectory_revision",
              "network_group",
              "unbounded",
              "remaining_range"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "room_id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 14
              },
              "x": {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              },
              "y": {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              },
              "direction_x": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "direction_y": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "radius": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 2
              },
              "speed": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 65
              },
              "enemy": {
                "type": "boolean"
              },
              "rune_bolt": {
                "type": "boolean"
              },
              "wind_volley": {
                "type": "boolean"
              },
              "bounces": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "penetrations": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "root": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "source_life": {
                "type": "integer",
                "minimum": 0
              },
              "damage": {
                "type": "integer",
                "minimum": 0
              },
              "frost": {
                "type": "boolean"
              },
              "chain": {
                "type": "boolean"
              },
              "trajectory_revision": {
                "type": "integer",
                "minimum": 0
              },
              "network_group": {
                "type": "integer",
                "minimum": 0,
                "maximum": 42
              },
              "unbounded": {
                "const": true
              },
              "remaining_range": {
                "type": "null"
              }
            }
          },
          "reason": {
            "enum": [
              null,
              "wall",
              "cover",
              "target_hit",
              "melee_block",
              "wind_clear",
              "room_clear",
              "technical_wait",
              "owner_permanent_exit",
              "terminal"
            ]
          },
          "delivery_sequence": {
            "type": "integer",
            "minimum": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "terminate"
                }
              }
            },
            "then": {
              "properties": {
                "reason": {
                  "type": "string"
                }
              }
            },
            "else": {
              "properties": {
                "reason": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    }
  }
}
